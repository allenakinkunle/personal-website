---
const { currentPath } = Astro.props;
const nav = [
  ['Math', '/math'],
  ['Tech', '/tech'],
  ['Music', '/music'],
  ['Books', '/books'],
  ['Photos', '/photos'],
  ['Life', '/life'],
  ['About', '/about'],
];
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Allen Akin, home">Allen Akin</a>
  <nav class="site-nav" aria-label="Primary navigation">
    {nav.map(([label, href]) => (
      <a href={href} aria-current={currentPath.startsWith(href) ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
</header>
