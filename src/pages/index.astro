---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BookOpen, Calculator, FileText, Images, Mail, Music2, NotebookPen, UserRound } from '@lucide/astro';

const programs = [
  { label: 'About Me', detail: 'Career, current work, and interests', href: '/about', icon: UserRound, color: 'orange' },
  { label: 'Tech Notes', detail: 'Technology, products, and building companies', href: '/tech', icon: NotebookPen, color: 'cyan' },
  { label: 'Math Lab', detail: 'Mathematics, machine learning, and statistics', href: '/math', icon: Calculator, color: 'yellow' },
  { label: 'Media Player', detail: 'Records and albums in rotation', href: '/music', icon: Music2, color: 'red' },
  { label: 'My Library', detail: 'Books and reading notes', href: '/books', icon: BookOpen, color: 'green' },
  { label: 'Just The Right Fit', detail: 'Personal notes', href: '/life', icon: FileText, color: 'pink' },
  { label: 'Subscribe', detail: 'Choose Tech Notes, Just The Right Fit, or both', href: '/subscribe', icon: Mail, color: 'mail' },
];
---

<BaseLayout>
  <section class="welcome-view">
    <header class="welcome-header">
      <p class="eyebrow">Builder · Thinker · Human</p>
      <h1>Allen Akin</h1>
      <p>Perpetually fascinated by problems and how to solve them with technology. I keep notes on the music, books, photographs, and questions that shape my life and work.</p>
    </header>

    <section class="welcome-panel" aria-labelledby="programs-heading">
      <h2 id="programs-heading">Programs and folders</h2>
      <div class="program-list">
        {programs.map(({ label, detail, href, icon: Icon, color }) => (
          <a href={href}>
            <span class={`program-icon shortcut-${color}`}><Icon size={22} stroke-width={1.8} /></span>
            <span><strong>{label}</strong><small>{detail}</small></span>
          </a>
        ))}
      </div>
    </section>

    <section class="welcome-note">
      <h2>Current note</h2>
      <strong>Building Rivets</strong>
      <p>Rivets puts AI workers inside the tools construction companies already use, autonomously executing finance and operational workflows, keeping enterprise systems in sync, and delivering the right information to the right people, from the jobsite to the back office.</p>
      <a href="/about">Open About Me</a>
    </section>
  </section>
</BaseLayout>

